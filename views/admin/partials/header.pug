header.header
  .container-fluid
    .row.align-items-center
      .col-3
        .inner-logo
          a(href="/admin/dashboard" class="text-decoration-none") ADMIN

      .col-9
        //- Bootstrap 5 không dùng "text-right"-> "text-end", "mr-2"->"me-2"
        div(class="text-end")
          a(
            href=`${prefixAdmin}/my-account`
            class="btn btn-primary btn-sm me-2"
          ) #{user.fullName}
          a(
            href=`${prefixAdmin}/auth/logout`
            class="btn btn-danger btn-sm"
          ) Đăng xuất