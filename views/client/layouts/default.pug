include ../mixins/alert.pug

doctype html
html 
  head 
    title #{pageTitle}

    //- Nhúng bootstrap
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css")

    //- file-upload-with-preview
    //link(rel="stylesheet", href="https://unpkg.com/file-upload-with-preview/dist/style.css")
    link(rel="stylesheet", href="https://unpkg.com/file-upload-with-preview@5.0.8/dist/file-upload-with-preview.min.css")

    //- viewerjs
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.15.2/viewer.css")

    link(rel="stylesheet", href="/css/style.css")


  body
    +alert-success(2000)

    include ../partials/header.pug

    block main

    include ../partials/footer.pug

    //- Nhúng bootstrap
    script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js")

    // SocketIO
    script(src="/socket.io/socket.io.js")
    script(src="/js/socket.js")

    //- emoji-picker-element
    script(type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js")
    //- End emoji-picker-element

    //- file-upload-with-preview
    // Đường dẫn không ghi phiên bản:
    // https://unpkg.com/file-upload-with-preview/dist/index.js
    // sẽ lấy phiên bản mới nhất của package; khi kiểm tra thì đó là v6.1.2. Vì không ghim phiên bản, URL có thể trỏ sang phiên bản khác khi package được cập nhật.
    // Với v6, file dist/index.js dùng dạng ES module. Nó không tạo biến global để gọi FileUploadWithPreview.FileUploadWithPreview(...). Hãy dùng module import và gọi constructor trực tiếp:
    // import { FileUploadWithPreview } from "https://cdn.jsdelivr.net/npm/file-upload-with-preview@6.1.2/+esm";
    // const upload = new FileUploadWithPreview("upload-images", {
    //   multiple: true,
    //   maxFileCount: 6
    // });
    //script(src="https://unpkg.com/file-upload-with-preview/dist/index.js")
    script(src="https://unpkg.com/file-upload-with-preview@5.0.8/dist/file-upload-with-preview.iife.js")
    

    //- viewerjs
    script(type="module" src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.15.2/viewer.js")

    //- script(type="module" src="/js/chat.js")
    //- script(src="/js/users.js")

    script(src="/js/script.js")
    
    block script 